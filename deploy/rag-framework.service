[Unit]
Description=RAG Framework API
After=network.target
Wants=rag-postgres.service

[Service]
Type=simple
User=rag
Group=rag
WorkingDirectory=/opt/rag-framework
EnvironmentFile=/opt/rag-framework/.env
ExecStart=/opt/rag-framework/.venv/bin/uvicorn main:app \
    --host ${APP_HOST:-0.0.0.0} \
    --port ${APP_PORT:-8000} \
    --workers 1

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rag-framework

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/rag-framework/eval_results

[Install]
WantedBy=multi-user.target
