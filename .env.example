# =============================================================================
# RAG Framework — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# All settings have defaults shown. Only OPENAI_API_KEY is strictly required
# when using LLM_PROVIDER=openai.
# =============================================================================

# ── 1. Required API Keys ───────────────────────────────────────────────────

OPENAI_API_KEY=sk-xxx
# PINECONE_API_KEY=                    # Only needed if USE_LOCAL_DB=false
# ADMIN_API_KEY=admin-change-me        # Override admin key for /admin endpoints

# ── 2. Core Application ────────────────────────────────────────────────────

APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
# APP_RELOAD=false                     # Auto-reload on code change (dev only)
# DEBUG=false

# ── 3. Database ────────────────────────────────────────────────────────────

USE_LOCAL_DB=true                      # true=PGVector, false=Pinecone
DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

# Connection Pooling
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT=30.0

# Pinecone (only used when USE_LOCAL_DB=false)
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=semantic-search-openai
# CLOUD=aws
# REGION=us-east-1

# ── 4. LLM Provider ────────────────────────────────────────────────────────

LLM_PROVIDER=openai                    # openai | ollama | llamacpp
LLM_MODEL=gpt-4o-mini

# OpenAI (used when LLM_PROVIDER=openai)
# LLM_TEMP=0
# LLM_MAX_TOKENS=2000
# LLM_REMOTE_TIMEOUT=60.0
# LLM_REMOTE_CONNECT_TIMEOUT=10.0

# Ollama (used when LLM_PROVIDER=ollama)
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# llama.cpp (local GGUF — used when LLM_PROVIDER=llamacpp)
# LOCAL_MODEL=models/Hermes-2-Pro-Llama-3-8B-Q4_K_M.gguf
# MODELS_DIR=models
# REMOTE_LLAMACPP_URL=http://192.168.0.225:8080
# LLM_N_CTX=4000
# LLM_N_GPU_LAYERS=-1                  # -1 = offload all to GPU
# LLM_QUEUE_TIMEOUT_SECONDS=120.0

# ── 5. Embeddings ──────────────────────────────────────────────────────────

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=512
# EMBEDDING_MODEL_MAX_TOKEN=8000

# ── 6. RAG Pipeline ────────────────────────────────────────────────────────

SYSTEM_PROMPT_FILE=default             # Name of .md file in app/prompts/system/
CHUNKING_STRATEGY=recursive            # recursive | semantic | paragraph
# ENABLE_TABLE_PARSING=true            # Extract tables from PDFs as Markdown
TOP_K=10
RETRIEVAL_TOP_K=10
# BATCH_SIZE=32                        # Embedding batch size

# ── 7. Reranker ────────────────────────────────────────────────────────────

RERANKER_ENABLED=true
RERANKER_PROVIDER=flashrank            # flashrank | bge | cohere
RERANK_TOP_K=3
# FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2

# ── 8. Auth & Security ─────────────────────────────────────────────────────

AUTH_ENABLED=true
# AUTH_EXEMPT_PATHS=/metrics,/docs,/openapi.json,/health,/login
# ADMIN_API_KEY=admin-change-me

# ── 9. Rate Limiting ───────────────────────────────────────────────────────
# IMPORTANT: Rate limiting uses in-memory counters per worker process.
# For accurate per-tenant limits, keep APP_WORKERS=1.
# With multiple workers, each worker has its own counter.

RATE_LIMIT_ENABLED=true
# RATE_LIMIT_QUERIES_PER_MINUTE=60
# RATE_LIMIT_INGEST_PER_MINUTE=10
# RATE_LIMIT_BURST_SIZE=5

# ── 10. CORS ───────────────────────────────────────────────────────────────

# CORS_ALLOWED_ORIGINS=*              # Comma-separated list of origins

# ── 11. Conversation Memory ─────────────────────────────────────────────────

# CONVERSATION_HISTORY_LENGTH=10       # Max messages to include in context

# ── 12. Observability ──────────────────────────────────────────────────────

OBSERVABILITY_ENABLED=true
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                     # console | json
# OTEL_EXPORTER_TYPE=console           # otlp | console | none
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# ── 13. Evaluation ─────────────────────────────────────────────────────────

# EVAL_ENABLED=true
# EVAL_METRICS=context_precision,context_recall,faithfulness,answer_relevancy
# EVAL_RESULTS_DIR=eval_results
